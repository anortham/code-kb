{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/code-kb-launcher.cjs\" hook SessionStart",
            "timeout": 60,
            "statusMessage": "Activating code-kb tools..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/code-kb-launcher.cjs\" hook SubagentStart",
            "timeout": 60,
            "statusMessage": "Activating code-kb tools for subagent..."
          }
        ]
      }
    ]
  }
}
