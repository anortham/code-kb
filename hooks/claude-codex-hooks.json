{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "code-kb hook SessionStart",
            "timeout": 5,
            "statusMessage": "Activating code-kb tools..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-kb hook SubagentStart",
            "timeout": 5,
            "statusMessage": "Activating code-kb tools for subagent..."
          }
        ]
      }
    ]
  }
}
