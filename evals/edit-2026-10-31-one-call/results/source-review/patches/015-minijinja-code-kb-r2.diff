--- a/minijinja-cli/tests/test_autoescape.rs
+++ b/minijinja-cli/tests/test_autoescape.rs
@@ -0,0 +1,92 @@
+use std::io::Write;
+use std::process::Command;
+
+use insta_cmd::get_cargo_bin;
+
+fn render(suffix: &str, mode: Option<&str>) -> String {
+    let mut template = tempfile::Builder::new().suffix(suffix).tempfile().unwrap();
+    template.write_all(b"{{ value }}").unwrap();
+    let mut command = Command::new(get_cargo_bin("minijinja-cli"));
+    command
+        .arg(template.path())
+        .arg("--no-newline")
+        .arg("-Dvalue=<tag>");
+    if let Some(mode) = mode {
+        command.arg("--autoescape").arg(mode);
+    }
+    let output = command.output().unwrap();
+    assert!(
+        output.status.success(),
+        "suffix={suffix:?}, mode={mode:?}: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8(output.stdout).unwrap()
+}
+
+#[test]
+fn autoescape_output_and_wrapper_suffixes() {
+    for (extension, expected) in [
+        ("htm", "&lt;tag&gt;"),
+        ("html", "&lt;tag&gt;"),
+        ("xml", "&lt;tag&gt;"),
+        ("xhtml", "&lt;tag&gt;"),
+        ("json", "\"<tag>\""),
+        ("json5", "\"<tag>\""),
+        ("yaml", "\"<tag>\""),
+        ("yml", "\"<tag>\""),
+    ] {
+        for wrapper in ["", ".j2", ".jinja", ".jinja2"] {
+            let suffix = format!(".{extension}{wrapper}");
+            for suffix in [suffix.clone(), suffix.to_ascii_uppercase()] {
+                assert_eq!(render(&suffix, None), expected, "suffix={suffix}");
+                assert_eq!(render(&suffix, Some("auto")), expected, "suffix={suffix}");
+            }
+        }
+    }
+    assert_eq!(render(".HtMl.JiNjA2", None), "&lt;tag&gt;");
+    assert_eq!(render(".JsOn.JiNjA", None), "\"<tag>\"");
+}
+
+#[test]
+fn autoescape_ignores_unknown_suffixes_and_strips_only_one_wrapper() {
+    for suffix in [
+        "",
+        ".txt",
+        ".j2",
+        ".jinja",
+        ".jinja2",
+        ".txt.j2",
+        ".txt.JINJA",
+        ".html.jinja2.j2",
+        ".json.j2.jinja2",
+        ".html.txt.jinja",
+        ".html.jinja2.bak",
+        ".html.",
+    ] {
+        assert_eq!(render(suffix, None), "<tag>", "suffix={suffix}");
+    }
+}
+
+#[test]
+fn explicit_autoescape_modes_override_suffixes() {
+    for suffix in [
+        "",
+        ".html",
+        ".json",
+        ".HTML.JINJA2",
+        ".JSON.JINJA",
+        ".txt.j2",
+    ] {
+        for (mode, expected) in [
+            ("html", "&lt;tag&gt;"),
+            ("json", "\"<tag>\""),
+            ("none", "<tag>"),
+        ] {
+            assert_eq!(
+                render(suffix, Some(mode)),
+                expected,
+                "suffix={suffix}, mode={mode}"
+            );
+        }
+    }
+}
