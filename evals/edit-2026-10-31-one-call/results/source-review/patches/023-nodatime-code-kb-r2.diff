     /// <summary>
+    /// Compares this date/time with another date/time by their physical days and then their times of day,
+    /// ignoring their calendar systems.
+    /// </summary>
+    /// <remarks>
+    /// Values in different calendar systems can be compared without changing either value's calendar.
+    /// </remarks>
+    /// <param name="other">The other local date/time to compare with this value.</param>
+    /// <returns>A value less than zero if this date/time is earlier than <paramref name="other"/>;
+    /// zero if they represent the same physical day and time of day; a value greater than zero if this
+    /// date/time is later than <paramref name="other"/>.</returns>
+    [Pure]
+    public int CompareToIgnoringCalendar(LocalDateTime other)
+    {
+        int dateComparison = date.CompareToIgnoringCalendar(other.date);
+        return dateComparison != 0 ? dateComparison : time.CompareTo(other.time);
+    }
