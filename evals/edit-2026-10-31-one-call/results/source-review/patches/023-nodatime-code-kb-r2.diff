+using NUnit.Framework;
+
+namespace NodaTime.Test;
+
+public partial class LocalDateTimeTest
+{
+    [Test]
+    public void CompareToIgnoringCalendar_PhysicalDayThenNanosecondOrdering()
+    {
+        var value = new LocalDateTime(2000, 1, 1, 12, 30).PlusNanoseconds(1);
+        foreach (var id in CalendarSystem.Ids)
+        {
+            var other = value.WithCalendar(CalendarSystem.ForId(id));
+            Assert.That(value.CompareToIgnoringCalendar(other), Is.Zero, id);
+            Assert.That(other.CompareToIgnoringCalendar(value), Is.Zero, id);
+            Assert.That(value.CompareToIgnoringCalendar(other.PlusNanoseconds(1)), Is.LessThan(0), id);
+            Assert.That(other.PlusNanoseconds(1).CompareToIgnoringCalendar(value), Is.GreaterThan(0), id);
+            Assert.That(value.CompareToIgnoringCalendar(other.PlusNanoseconds(-1)), Is.GreaterThan(0), id);
+            Assert.That(other.PlusNanoseconds(-1).CompareToIgnoringCalendar(value), Is.LessThan(0), id);
+            Assert.That(value.CompareToIgnoringCalendar(other.Date.PlusDays(1).AtMidnight()), Is.LessThan(0), id);
+            Assert.That(value.CompareToIgnoringCalendar(other.Date.PlusDays(-1).At(LocalTime.MaxValue)), Is.GreaterThan(0), id);
+            Assert.That(other.Calendar, Is.SameAs(CalendarSystem.ForId(id)));
+        }
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_IdenticalFieldsInDifferentCalendars()
+    {
+        var iso = new LocalDateTime(1970, 1, 1, 23, 59);
+        var julian = new LocalDateTime(1970, 1, 1, 0, 0, CalendarSystem.Julian);
+        Assert.That(iso.CompareToIgnoringCalendar(julian), Is.LessThan(0));
+        Assert.That(julian.CompareToIgnoringCalendar(iso), Is.GreaterThan(0));
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_FullDateRange()
+    {
+        var copticEpoch = new LocalDateTime(1, 1, 1, 0, 0, CalendarSystem.Coptic);
+        var beforeBclRange = new LocalDateTime(0, 1, 1, 12, 30);
+        Assert.That(LocalDateTime.MinIsoValue.CompareToIgnoringCalendar(LocalDateTime.MaxIsoValue), Is.LessThan(0));
+        Assert.That(LocalDateTime.MaxIsoValue.CompareToIgnoringCalendar(LocalDateTime.MinIsoValue), Is.GreaterThan(0));
+        Assert.That(LocalDateTime.MinIsoValue.CompareToIgnoringCalendar(copticEpoch), Is.LessThan(0));
+        Assert.That(LocalDateTime.MaxIsoValue.CompareToIgnoringCalendar(copticEpoch), Is.GreaterThan(0));
+        Assert.That(beforeBclRange.CompareToIgnoringCalendar(beforeBclRange.WithCalendar(CalendarSystem.Julian)), Is.Zero);
+        Assert.That(default(LocalDateTime).CompareToIgnoringCalendar(new LocalDateTime(1, 1, 1, 0, 0)), Is.Zero);
+    }
+}
