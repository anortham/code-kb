+using NUnit.Framework;
+using System;
+
+namespace NodaTime.Test;
+
+public partial class LocalDateTest
+{
+    [Test]
+    public void CompareToIgnoringCalendar_PhysicalDayOrdering()
+    {
+        var date = new LocalDate(2000, 1, 1);
+        foreach (var id in CalendarSystem.Ids)
+        {
+            var other = date.WithCalendar(CalendarSystem.ForId(id));
+            Assert.That(date.CompareToIgnoringCalendar(other), Is.Zero, id);
+            Assert.That(other.CompareToIgnoringCalendar(date), Is.Zero, id);
+            Assert.That(date.CompareToIgnoringCalendar(other.PlusDays(1)), Is.LessThan(0), id);
+            Assert.That(other.PlusDays(1).CompareToIgnoringCalendar(date), Is.GreaterThan(0), id);
+            Assert.That(date.CompareToIgnoringCalendar(other.PlusDays(-1)), Is.GreaterThan(0), id);
+            Assert.That(other.PlusDays(-1).CompareToIgnoringCalendar(date), Is.LessThan(0), id);
+            Assert.That(other.Calendar, Is.SameAs(CalendarSystem.ForId(id)));
+        }
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_IdenticalFieldsInDifferentCalendars()
+    {
+        var iso = new LocalDate(1970, 1, 1);
+        var julian = new LocalDate(1970, 1, 1, CalendarSystem.Julian);
+        Assert.That(iso.CompareToIgnoringCalendar(julian), Is.LessThan(0));
+        Assert.That(julian.CompareToIgnoringCalendar(iso), Is.GreaterThan(0));
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_FullDateRange()
+    {
+        var copticEpoch = new LocalDate(1, 1, 1, CalendarSystem.Coptic);
+        var beforeBclRange = new LocalDate(0, 1, 1);
+        Assert.That(LocalDate.MinIsoValue.CompareToIgnoringCalendar(LocalDate.MaxIsoValue), Is.LessThan(0));
+        Assert.That(LocalDate.MaxIsoValue.CompareToIgnoringCalendar(LocalDate.MinIsoValue), Is.GreaterThan(0));
+        Assert.That(LocalDate.MinIsoValue.CompareToIgnoringCalendar(copticEpoch), Is.LessThan(0));
+        Assert.That(LocalDate.MaxIsoValue.CompareToIgnoringCalendar(copticEpoch), Is.GreaterThan(0));
+        Assert.That(beforeBclRange.CompareToIgnoringCalendar(beforeBclRange.WithCalendar(CalendarSystem.Julian)), Is.Zero);
+        Assert.That(default(LocalDate).CompareToIgnoringCalendar(new LocalDate(1, 1, 1)), Is.Zero);
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_DoesNotChangeCalendarSensitiveComparison()
+    {
+        var iso = new LocalDate(1970, 1, 1);
+        var julian = new LocalDate(1969, 12, 19, CalendarSystem.Julian);
+        Assert.That(iso.CompareToIgnoringCalendar(julian), Is.Zero);
+        Assert.That(iso.Equals(julian), Is.False);
+        Assert.That(iso == julian, Is.False);
+        Assert.That(iso != julian, Is.True);
+        Assert.Throws<ArgumentException>(() => iso.CompareTo(julian));
+        Assert.Throws<ArgumentException>(() => (iso < julian).ToString());
+        Assert.That(iso.Calendar, Is.SameAs(CalendarSystem.Iso));
+        Assert.That(julian.Calendar, Is.SameAs(CalendarSystem.Julian));
+    }
+}
