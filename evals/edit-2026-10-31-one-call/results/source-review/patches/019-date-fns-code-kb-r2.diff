--- a/pkgs/core/src/differenceInBusinessDays/context/test.ts
+++ b/pkgs/core/src/differenceInBusinessDays/context/test.ts
@@ -0,0 +1,31 @@
+import { TZDate, tz } from "@date-fns/tz";
+import { describe, expect, it } from "vitest";
+import { differenceInBusinessDays } from "../index.ts";
+
+describe("differenceInBusinessDays timezone boundaries", () => {
+  it.each([
+    ["2024-04-09T04:01:00Z", "2024-04-09T03:59:00Z", "America/New_York", 1],
+    ["2024-04-09T03:59:00Z", "2024-04-09T04:01:00Z", "America/New_York", -1],
+    ["2024-04-08T16:01:00Z", "2024-04-08T15:59:00Z", "Asia/Singapore", 1],
+    ["2024-04-08T15:59:00Z", "2024-04-08T16:01:00Z", "Asia/Singapore", -1],
+    ["2024-04-10T03:59:00Z", "2024-04-09T04:01:00Z", "America/New_York", 0],
+    ["2024-04-09T15:59:00Z", "2024-04-08T16:01:00Z", "Asia/Singapore", 0],
+    ["2024-04-16T04:01:00Z", "2024-04-09T03:59:00Z", "America/New_York", 6],
+    ["2024-04-09T03:59:00Z", "2024-04-16T04:01:00Z", "America/New_York", -6],
+    ["2024-03-12T04:01:00Z", "2024-03-09T04:59:00Z", "America/New_York", 2],
+  ] as const)("compares %s and %s in %s", (later, earlier, zone, expected) => {
+    expect(differenceInBusinessDays(later, earlier, { in: tz(zone) })).toBe(
+      expected,
+    );
+  });
+
+  it("overrides the context of date objects and accepts timestamps", () => {
+    const later = new TZDate("2024-04-09T04:01:00Z", "Asia/Singapore");
+    const earlier = new Date("2024-04-09T03:59:00Z");
+    for (const date of [later, +later]) {
+      expect(
+        differenceInBusinessDays(date, earlier, { in: tz("America/New_York") }),
+      ).toBe(1);
+    }
+  });
+});
