--- a/pkgs/core/src/addBusinessDays/context/test.ts
+++ b/pkgs/core/src/addBusinessDays/context/test.ts
@@ -0,0 +1,91 @@
+import { TZDate, tz } from "@date-fns/tz";
+import { describe, expect, it } from "vitest";
+import { subBusinessDays } from "../../subBusinessDays/index.ts";
+import { addBusinessDays } from "../index.ts";
+
+describe("addBusinessDays timezone boundaries", () => {
+  it.each([
+    [
+      "2024-08-20T15:59:00Z",
+      3,
+      "Asia/Singapore",
+      "2024-08-23T23:59:00.000+08:00",
+    ],
+    [
+      "2024-08-20T16:01:00Z",
+      3,
+      "Asia/Singapore",
+      "2024-08-26T00:01:00.000+08:00",
+    ],
+    [
+      "2024-08-21T03:59:00Z",
+      3,
+      "America/New_York",
+      "2024-08-23T23:59:00.000-04:00",
+    ],
+    [
+      "2024-08-21T04:01:00Z",
+      3,
+      "America/New_York",
+      "2024-08-26T00:01:00.000-04:00",
+    ],
+    [
+      "2024-08-24T03:59:00Z",
+      -5,
+      "America/New_York",
+      "2024-08-16T23:59:00.000-04:00",
+    ],
+    [
+      "2024-08-24T04:01:00Z",
+      -5,
+      "America/New_York",
+      "2024-08-19T00:01:00.000-04:00",
+    ],
+    [
+      "2024-08-23T16:01:00Z",
+      5,
+      "Asia/Singapore",
+      "2024-08-30T00:01:00.000+08:00",
+    ],
+    [
+      "2024-03-09T04:59:00Z",
+      1,
+      "America/New_York",
+      "2024-03-11T23:59:00.000-04:00",
+    ],
+  ] as const)(
+    "shifts %s by %i business days in %s",
+    (input, amount, zone, expected) => {
+      const result = addBusinessDays(input, amount, { in: tz(zone) });
+      expect(result).toBeInstanceOf(TZDate);
+      expect(result.toISOString()).toBe(expected);
+    },
+  );
+
+  it("uses the context for date objects and timestamps without mutating the input", () => {
+    const input = new TZDate("2024-08-20T16:01:00Z", "America/New_York");
+    const original = input.toISOString();
+    for (const date of [input, new Date(+input), +input]) {
+      expect(
+        addBusinessDays(date, 3, { in: tz("Asia/Singapore") }).toISOString(),
+      ).toBe("2024-08-26T00:01:00.000+08:00");
+    }
+    expect(input.toISOString()).toBe(original);
+  });
+
+  it("constructs zero-day results in the context", () => {
+    expect(
+      addBusinessDays("2024-08-20T16:01:00Z", 0, {
+        in: tz("Asia/Singapore"),
+      }).toISOString(),
+    ).toBe("2024-08-21T00:01:00.000+08:00");
+  });
+
+  it("applies the context through subBusinessDays", () => {
+    expect(
+      subBusinessDays("2024-08-24T04:01:00Z", 5, {
+        in: tz("America/New_York"),
+      }).toISOString(),
+    ).toBe("2024-08-19T00:01:00.000-04:00");
+  });
+});
