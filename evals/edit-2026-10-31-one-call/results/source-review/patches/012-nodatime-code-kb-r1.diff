     /// <summary>
+    /// Compares the physical day and time of day of this value with another date/time, ignoring their calendar systems.
+    /// </summary>
+    /// <remarks>
+    /// The comparison uses the number of days since the Unix epoch first, then the time of day.
+    /// Unlike <see cref="CompareTo(LocalDateTime)"/>, this method allows values in different calendar systems.
+    /// </remarks>
+    /// <param name="other">The other local date/time to compare with this value.</param>
+    /// <returns>A value less than zero if this date/time is earlier than <paramref name="other"/>;
+    /// zero if they represent the same physical day and time of day; a value greater than zero if this date/time is later.</returns>
+    [Pure]
+    public int CompareToIgnoringCalendar(LocalDateTime other)
+    {
+        int dateComparison = date.CompareToIgnoringCalendar(other.date);
+        return dateComparison != 0 ? dateComparison : time.CompareTo(other.time);
+    }
