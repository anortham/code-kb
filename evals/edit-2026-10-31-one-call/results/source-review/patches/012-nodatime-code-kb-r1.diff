+using NUnit.Framework;
+
+namespace NodaTime.Test;
+
+public partial class LocalDateTest
+{
+    [Test]
+    public void CompareToIgnoringCalendar_AllCalendars()
+    {
+        var epoch = new LocalDate(1970, 1, 1);
+        foreach (string id in CalendarSystem.Ids)
+        {
+            var calendar = CalendarSystem.ForId(id);
+            var sameDay = epoch.WithCalendar(calendar);
+            Assert.That(epoch.CompareToIgnoringCalendar(sameDay), Is.Zero, id);
+            Assert.That(sameDay.CompareToIgnoringCalendar(epoch), Is.Zero, id);
+            Assert.That(epoch.CompareToIgnoringCalendar(sameDay.PlusDays(-1)), Is.GreaterThan(0), id);
+            Assert.That(epoch.CompareToIgnoringCalendar(sameDay.PlusDays(1)), Is.LessThan(0), id);
+            Assert.That(sameDay.PlusDays(-1).CompareToIgnoringCalendar(epoch), Is.LessThan(0), id);
+            Assert.That(sameDay.PlusDays(1).CompareToIgnoringCalendar(epoch), Is.GreaterThan(0), id);
+            Assert.That(sameDay.CompareToIgnoringCalendar(sameDay.PlusDays(1)), Is.LessThan(0), id);
+            Assert.AreSame(calendar, sameDay.Calendar);
+        }
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_SameFieldsDifferentPhysicalDays()
+    {
+        var iso = new LocalDate(1970, 1, 1);
+        var julian = new LocalDate(1970, 1, 1, CalendarSystem.Julian);
+        Assert.That(iso.CompareToIgnoringCalendar(julian), Is.LessThan(0));
+        Assert.That(julian.CompareToIgnoringCalendar(iso), Is.GreaterThan(0));
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_ExtremeDates()
+    {
+        // The minimum ISO date is outside the range of the Julian calendar.
+        var julian = new LocalDate(CalendarSystem.Julian.MaxYear, 12, 31, CalendarSystem.Julian);
+        Assert.That(LocalDate.MinIsoValue.CompareToIgnoringCalendar(LocalDate.MinIsoValue), Is.Zero);
+        Assert.That(LocalDate.MinIsoValue.CompareToIgnoringCalendar(julian), Is.LessThan(0));
+        Assert.That(julian.CompareToIgnoringCalendar(LocalDate.MinIsoValue), Is.GreaterThan(0));
+        Assert.That(LocalDate.MaxIsoValue.CompareToIgnoringCalendar(julian), Is.GreaterThan(0));
+    }
+}
