+// Copyright 2026 The Noda Time Authors. All rights reserved.
+// Use of this source code is governed by the Apache License 2.0,
+// as found in the LICENSE.txt file.
+
+using NUnit.Framework;
+
+namespace NodaTime.Test;
+
+public partial class LocalDateTimeTest
+{
+    [Test]
+    public void CompareToIgnoringCalendar_AllCalendars()
+    {
+        var epoch = new LocalDateTime(1970, 1, 1, 12, 34, 56).PlusNanoseconds(123456789);
+        foreach (string id in CalendarSystem.Ids)
+        {
+            var calendar = CalendarSystem.ForId(id);
+            var sameTime = epoch.WithCalendar(calendar);
+            Assert.That(epoch.CompareToIgnoringCalendar(sameTime), Is.Zero, id);
+            Assert.That(sameTime.CompareToIgnoringCalendar(epoch), Is.Zero, id);
+            Assert.That(epoch.CompareToIgnoringCalendar(sameTime.PlusNanoseconds(-1)), Is.GreaterThan(0), id);
+            Assert.That(epoch.CompareToIgnoringCalendar(sameTime.PlusNanoseconds(1)), Is.LessThan(0), id);
+            Assert.That(sameTime.PlusNanoseconds(-1).CompareToIgnoringCalendar(epoch), Is.LessThan(0), id);
+            Assert.That(sameTime.PlusNanoseconds(1).CompareToIgnoringCalendar(epoch), Is.GreaterThan(0), id);
+            Assert.That(sameTime.CompareToIgnoringCalendar(sameTime.PlusNanoseconds(1)), Is.LessThan(0), id);
+            Assert.AreSame(calendar, sameTime.Calendar);
+        }
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_PhysicalDayTakesPriorityOverTimeOfDay()
+    {
+        var earlier = new LocalDate(1969, 12, 31) + LocalTime.MaxValue;
+        var later = new LocalDate(1970, 1, 1, CalendarSystem.Julian).AtMidnight();
+        Assert.That(earlier.CompareToIgnoringCalendar(later), Is.LessThan(0));
+        Assert.That(later.CompareToIgnoringCalendar(earlier), Is.GreaterThan(0));
+
+        // The ISO fields sort later, but the physical day is earlier.
+        var iso = new LocalDate(1970, 1, 1) + LocalTime.MaxValue;
+        var julian = new LocalDate(1969, 12, 20, CalendarSystem.Julian).AtMidnight();
+        Assert.That(iso.CompareToIgnoringCalendar(julian), Is.LessThan(0));
+        Assert.That(julian.CompareToIgnoringCalendar(iso), Is.GreaterThan(0));
+    }
+
+    [Test]
+    public void CompareToIgnoringCalendar_ExtremeDates()
+    {
+        var julian = new LocalDate(CalendarSystem.Julian.MaxYear, 12, 31, CalendarSystem.Julian).AtMidnight();
+        Assert.That(LocalDateTime.MinIsoValue.CompareToIgnoringCalendar(LocalDateTime.MinIsoValue), Is.Zero);
+        Assert.That(LocalDateTime.MinIsoValue.CompareToIgnoringCalendar(julian), Is.LessThan(0));
+        Assert.That(julian.CompareToIgnoringCalendar(LocalDateTime.MinIsoValue), Is.GreaterThan(0));
+        Assert.That(LocalDateTime.MaxIsoValue.CompareToIgnoringCalendar(julian), Is.GreaterThan(0));
+    }
+}
