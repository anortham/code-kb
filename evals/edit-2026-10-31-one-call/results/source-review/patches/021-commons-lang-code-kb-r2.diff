+package org.apache.commons.lang3.compare;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import java.math.BigDecimal;
+import java.sql.Date;
+
+import org.apache.commons.lang3.AbstractLangTest;
+import org.apache.commons.lang3.ObjectUtils;
+import org.junit.jupiter.api.Test;
+
+class ComparableUtilsMigrationTest extends AbstractLangTest {
+
+    @Test
+    void testCompareDefaultNullOrdering() {
+        assertEquals(0, ComparableUtils.<String>compare(null, null));
+        assertEquals(-1, ComparableUtils.compare(null, "a"));
+        assertEquals(1, ComparableUtils.compare("a", null));
+        assertEquals(0, ComparableUtils.compare("a", "a"));
+        assertEquals("a".compareTo("z"), ComparableUtils.compare("a", "z"));
+        assertEquals("z".compareTo("a"), ComparableUtils.compare("z", "a"));
+    }
+
+    @Test
+    void testCompareNullOrderingFlagAndCompatibility() {
+        final String[] values = {null, "a", "z"};
+        for (final boolean nullGreater : new boolean[] {false, true}) {
+            for (final String first : values) {
+                for (final String second : values) {
+                    final int expected;
+                    if (first == null && second == null) {
+                        expected = 0;
+                    } else if (first == null) {
+                        expected = nullGreater ? 1 : -1;
+                    } else if (second == null) {
+                        expected = nullGreater ? -1 : 1;
+                    } else {
+                        expected = first.compareTo(second);
+                    }
+                    assertEquals(expected, ComparableUtils.compare(first, second, nullGreater));
+                    assertEquals(expected, ObjectUtils.compare(first, second, nullGreater));
+                    if (!nullGreater) {
+                        assertEquals(expected, ObjectUtils.compare(first, second));
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void testComparableToSupertype() {
+        final Date first = new Date(0);
+        final Date second = new Date(1000);
+        assertEquals(-1, ComparableUtils.<Date>compare(first, second));
+        assertEquals(-1, ComparableUtils.<Date>compare(first, second, true));
+        final Date maximum = ComparableUtils.max(first, null, second);
+        final Date minimum = ComparableUtils.min(second, null, first);
+        assertSame(second, maximum);
+        assertSame(first, minimum);
+        assertEquals(-1, ObjectUtils.<Date>compare(first, second));
+        assertEquals(-1, ObjectUtils.<Date>compare(first, second, true));
+        assertSame(second, ObjectUtils.max(first, null, second));
+        assertSame(first, ObjectUtils.min(second, null, first));
+    }
+
+    @Test
+    void testEmptyAndNullVarargs() {
+        assertNull(ComparableUtils.<Integer>max());
+        assertNull(ComparableUtils.<Integer>min());
+        assertNull(ComparableUtils.max((Integer[]) null));
+        assertNull(ComparableUtils.min((Integer[]) null));
+        assertNull(ComparableUtils.max(new Integer[0]));
+        assertNull(ComparableUtils.min(new Integer[0]));
+        assertNull(ComparableUtils.max(new Integer[] {null, null, null}));
+        assertNull(ComparableUtils.min(new Integer[] {null, null, null}));
+        assertNull(ComparableUtils.max((Integer) null));
+        assertNull(ComparableUtils.min((Integer) null));
+        assertEquals(3, ComparableUtils.max(3));
+        assertEquals(3, ComparableUtils.min(3));
+    }
+
+    @Test
+    void testVarargsExtremaAndTies() {
+        final BigDecimal first = new BigDecimal("2.0");
+        final BigDecimal equal = new BigDecimal("2.00");
+        final BigDecimal lesser = BigDecimal.ONE;
+        final BigDecimal greater = BigDecimal.TEN;
+        assertSame(first, ComparableUtils.max(null, lesser, first, equal, null));
+        assertSame(first, ComparableUtils.min(null, greater, first, equal, null));
+        assertSame(first, ComparableUtils.max(new BigDecimal[] {first, equal}));
+        assertSame(first, ComparableUtils.min(new BigDecimal[] {first, equal}));
+        assertSame(first, ObjectUtils.max(null, lesser, first, equal, null));
+        assertSame(first, ObjectUtils.min(null, greater, first, equal, null));
+        assertSame(equal, ComparableUtils.max(first, equal));
+        assertSame(equal, ComparableUtils.min(first, equal));
+    }
