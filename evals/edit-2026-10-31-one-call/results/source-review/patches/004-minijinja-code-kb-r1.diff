--- a/minijinja-cli/tests/test_autoescape.rs
+++ b/minijinja-cli/tests/test_autoescape.rs
@@ -0,0 +1,96 @@
+use std::fs;
+use std::process::Command;
+
+use insta_cmd::get_cargo_bin;
+
+const RAW: &str = "<tag>\"&";
+const HTML: &str = "&lt;tag&gt;&quot;&amp;";
+const JSON: &str = "\"<tag>\\\"&\"";
+
+fn assert_autoescape(suffix: &str, mode: Option<&str>, expected: &str) {
+    let dir = tempfile::tempdir().unwrap();
+    let template = dir.path().join(format!("report{suffix}"));
+    fs::write(&template, "{{ value }}").unwrap();
+
+    let mut command = Command::new(get_cargo_bin("minijinja-cli"));
+    command.arg(&template).arg("--no-newline");
+    command.arg(format!("-Dvalue={RAW}"));
+    if let Some(mode) = mode {
+        command.arg(format!("--autoescape={mode}"));
+    }
+    let output = command.output().unwrap();
+    assert!(
+        output.status.success(),
+        "{suffix} ({mode:?}): {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(
+        String::from_utf8(output.stdout).unwrap(),
+        expected,
+        "{suffix} ({mode:?})"
+    );
+    assert!(output.stderr.is_empty());
+}
+
+#[test]
+fn test_autoescape_suffixes() {
+    for (suffix, expected) in [
+        ("html", HTML),
+        ("htm", HTML),
+        ("xml", HTML),
+        ("xhtml", HTML),
+        ("json", JSON),
+        ("json5", JSON),
+        ("yaml", JSON),
+        ("yml", JSON),
+        ("txt", RAW),
+    ] {
+        for wrapper in ["", ".j2", ".jinja", ".jinja2"] {
+            let suffix = format!(".{suffix}{wrapper}");
+            assert_autoescape(&suffix, None, expected);
+            assert_autoescape(&suffix.to_ascii_uppercase(), Some("auto"), expected);
+        }
+    }
+    assert_autoescape(".hTmL.JiNjA2", Some("auto"), HTML);
+    assert_autoescape(".JsOn.j2", Some("auto"), JSON);
+}
+
+#[test]
+fn test_autoescape_skips_only_one_wrapper() {
+    for suffix in [
+        "",
+        ".j2",
+        ".jinja",
+        ".jinja2",
+        ".html.j2.jinja2",
+        ".json.jinja.j2",
+        ".html.txt.jinja",
+        ".html.j2.bak",
+        ".json.jinja3",
+    ] {
+        assert_autoescape(suffix, Some("auto"), RAW);
+    }
+}
+
+#[test]
+fn test_explicit_autoescape_overrides_suffixes() {
+    for suffix in [".html", ".html.JINJA2", ".JSON", ".JSON.j2", ".txt"] {
+        for (mode, expected) in [("html", HTML), ("json", JSON), ("none", RAW)] {
+            assert_autoescape(suffix, Some(mode), expected);
+        }
+    }
+}
+
+#[test]
+fn test_autoescape_long_help() {
+    let output = Command::new(get_cargo_bin("minijinja-cli"))
+        .arg("--long-help")
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    let help = String::from_utf8(output.stdout).unwrap();
+    let help = help.split_whitespace().collect::<Vec<_>>().join(" ");
+    assert!(help.contains(".j2, .jinja, or .jinja2 suffix is ignored"));
+    assert!(help.contains("ASCII case-insensitive"));
+    assert!(help.contains("explicit modes override file extension detection"));
+}
