@@ -0,0 +1,30 @@
+import { TZDate, tz } from "@date-fns/tz";
+import { describe, expect, it } from "vitest";
+import { differenceInBusinessDays } from "../index.ts";
+
+describe("business-day differences in a timezone context", () => {
+  it.each([
+    ["2024-08-23T04:00:00Z", "2024-08-23T03:59:00Z", "America/New_York", 1],
+    ["2024-08-21T16:00:00Z", "2024-08-21T15:59:00Z", "Asia/Singapore", 1],
+    ["2024-08-22T03:59:00Z", "2024-08-21T15:59:00Z", "America/New_York", 0],
+    ["2024-08-21T15:59:00Z", "2024-08-20T16:00:00Z", "Asia/Singapore", 0],
+    ["2024-08-30T04:00:00Z", "2024-08-23T03:59:00Z", "America/New_York", 6],
+    ["2024-03-12T03:30:00Z", "2024-03-09T04:30:00Z", "America/New_York", 1],
+  ])(
+    "compares %s and %s using calendar days in %s",
+    (later, earlier, zone, expected) => {
+      for (const [left, right] of [
+        [later, earlier],
+        [Date.parse(later), Date.parse(earlier)],
+        [new Date(later), new Date(earlier)],
+        [new TZDate(later, "UTC"), new TZDate(earlier, "Asia/Tokyo")],
+      ]) {
+        const options = { in: tz(zone) };
+        expect(differenceInBusinessDays(left, right, options)).toBe(expected);
+        expect(differenceInBusinessDays(right, left, options)).toBe(
+          expected === 0 ? 0 : -expected,
+        );
+      }
+    },
+  );
+});
