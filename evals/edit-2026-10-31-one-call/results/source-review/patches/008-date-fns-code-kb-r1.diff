@@ -0,0 +1,83 @@
+import { TZDate, tz } from "@date-fns/tz";
+import { describe, expect, it } from "vitest";
+import { addBusinessDays } from "../index.ts";
+import { subBusinessDays } from "../../subBusinessDays/index.ts";
+
+describe("business-day arithmetic in a timezone context", () => {
+  it.each([
+    [
+      "2024-08-20T15:59:00Z",
+      "Asia/Singapore",
+      3,
+      "2024-08-23T23:59:00.000+08:00",
+    ],
+    [
+      "2024-08-20T16:00:00Z",
+      "Asia/Singapore",
+      3,
+      "2024-08-26T00:00:00.000+08:00",
+    ],
+    [
+      "2024-08-21T03:59:00Z",
+      "America/New_York",
+      3,
+      "2024-08-23T23:59:00.000-04:00",
+    ],
+    [
+      "2024-08-21T04:00:00Z",
+      "America/New_York",
+      3,
+      "2024-08-26T00:00:00.000-04:00",
+    ],
+    [
+      "2024-08-24T03:59:00Z",
+      "America/New_York",
+      -5,
+      "2024-08-16T23:59:00.000-04:00",
+    ],
+    [
+      "2024-08-23T16:00:00Z",
+      "Asia/Singapore",
+      5,
+      "2024-08-30T00:00:00.000+08:00",
+    ],
+    [
+      "2024-08-23T16:00:00Z",
+      "Asia/Singapore",
+      -5,
+      "2024-08-19T00:00:00.000+08:00",
+    ],
+    [
+      "2024-08-23T16:00:00Z",
+      "Asia/Singapore",
+      0,
+      "2024-08-24T00:00:00.000+08:00",
+    ],
+    [
+      "2024-03-09T04:30:00Z",
+      "America/New_York",
+      1,
+      "2024-03-11T23:30:00.000-04:00",
+    ],
+  ])("shifts %s in %s by %s business days", (input, zone, amount, expected) => {
+    // The context must override both plain dates and another date extension's zone.
+    for (const date of [
+      input,
+      Date.parse(input),
+      new Date(input),
+      new TZDate(input, "UTC"),
+    ]) {
+      const result = addBusinessDays(date, amount, { in: tz(zone) });
+      expect(result).toBeInstanceOf(TZDate);
+      expect(result.toISOString()).toBe(expected);
+    }
+  });
+
+  it("passes the context through subtraction", () => {
+    expect(
+      subBusinessDays("2024-08-24T03:59:00Z", 5, {
+        in: tz("America/New_York"),
+      }).toISOString(),
+    ).toBe("2024-08-16T23:59:00.000-04:00");
+  });
+});
