+package org.apache.commons.lang3.compare;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+import org.apache.commons.lang3.AbstractLangTest;
+import org.apache.commons.lang3.ObjectUtils;
+import org.junit.jupiter.api.Test;
+
+class ComparableUtilsMigrationTest extends AbstractLangTest {
+
+    @Test
+    void testCompareNullOrderingAndNaturalOrder() {
+        final String[] values = {null, "a", "z"};
+        final int[][] nullLess = {{0, -1, -1}, {1, 0, -25}, {1, 25, 0}};
+        final int[][] nullGreater = {{0, 1, 1}, {-1, 0, -25}, {-1, 25, 0}};
+        for (int i = 0; i < values.length; i++) {
+            for (int j = 0; j < values.length; j++) {
+                assertEquals(nullLess[i][j], ComparableUtils.compare(values[i], values[j]));
+                assertEquals(nullLess[i][j], ComparableUtils.compare(values[i], values[j], false));
+                assertEquals(nullGreater[i][j], ComparableUtils.compare(values[i], values[j], true));
+                assertEquals(nullLess[i][j], ObjectUtils.compare(values[i], values[j]));
+                assertEquals(nullLess[i][j], ObjectUtils.compare(values[i], values[j], false));
+                assertEquals(nullGreater[i][j], ObjectUtils.compare(values[i], values[j], true));
+            }
+        }
+    }
+
+    @Test
+    void testEmptyAndAllNullVarargs() {
+        assertNull(ComparableUtils.max());
+        assertNull(ComparableUtils.min());
+        final Integer[][] arrays = {null, {}, {null}, {null, null, null}};
+        for (final Integer[] values : arrays) {
+            assertNull(ComparableUtils.max(values));
+            assertNull(ComparableUtils.min(values));
+            assertNull(ObjectUtils.max(values));
+            assertNull(ObjectUtils.min(values));
+        }
+    }
+
+    @Test
+    void testVarargsIgnoreNullsAndFindExtremes() {
+        final Integer[][] arrays = {{null, 3, 1, null, 2, null}, {1, 2, 3}, {3, 2, 1}};
+        for (final Integer[] values : arrays) {
+            assertEquals(3, ComparableUtils.max(values));
+            assertEquals(1, ComparableUtils.min(values));
+            assertEquals(3, ObjectUtils.max(values));
+            assertEquals(1, ObjectUtils.min(values));
+        }
+        assertEquals(2, ComparableUtils.max(null, 2, null));
+        assertEquals(2, ComparableUtils.min(null, 2, null));
+        assertEquals(3, ComparableUtils.max(null, 1, 3, 2));
+        assertEquals(1, ComparableUtils.min(null, 1, 3, 2));
+        assertEquals(2, ComparableUtils.max(2));
+        assertEquals(2, ComparableUtils.min(2));
+    }
+
+    @Test
+    void testTieIdentityForVarargsAndTwoValueOverloads() {
+        final BigDecimal first = new BigDecimal("1.0");
+        final BigDecimal second = new BigDecimal("1.00");
+        final BigDecimal[] values = {null, first, second, null};
+        assertSame(first, ComparableUtils.max(values));
+        assertSame(first, ComparableUtils.min(values));
+        assertSame(first, ComparableUtils.max(new BigDecimal[] {first, second}));
+        assertSame(first, ComparableUtils.min(new BigDecimal[] {first, second}));
+        assertSame(first, ObjectUtils.max(first, second));
+        assertSame(first, ObjectUtils.min(first, second));
+        assertSame(second, ComparableUtils.max(first, second));
+        assertSame(second, ComparableUtils.min(first, second));
+        assertSame(first, ComparableUtils.max(first, null));
+        assertSame(first, ComparableUtils.min(first, null));
+        assertSame(first, ComparableUtils.max(null, first));
+        assertSame(first, ComparableUtils.min(null, first));
+        assertNull(ComparableUtils.<BigDecimal>max(null, null));
+        assertNull(ComparableUtils.<BigDecimal>min(null, null));
+    }
+
+    @Test
+    void testComparableToSupertype() {
+        // LocalDate implements Comparable<ChronoLocalDate> rather than Comparable<LocalDate>.
+        final LocalDate earlier = LocalDate.of(2020, 1, 1);
+        final LocalDate later = earlier.plusDays(1);
+        assertEquals(earlier.compareTo(later), ComparableUtils.<LocalDate>compare(earlier, later));
+        assertEquals(earlier.compareTo(later), ComparableUtils.<LocalDate>compare(earlier, later, true));
+        assertEquals(earlier.compareTo(later), ObjectUtils.<LocalDate>compare(earlier, later));
+        assertEquals(earlier.compareTo(later), ObjectUtils.<LocalDate>compare(earlier, later, true));
+        final LocalDate maximum = ComparableUtils.<LocalDate>max(null, earlier, later);
+        final LocalDate minimum = ComparableUtils.<LocalDate>min(null, earlier, later);
+        assertSame(later, maximum);
+        assertSame(earlier, minimum);
+        assertSame(later, ObjectUtils.<LocalDate>max(null, earlier, later));
+        assertSame(earlier, ObjectUtils.<LocalDate>min(null, earlier, later));
+    }
+}
