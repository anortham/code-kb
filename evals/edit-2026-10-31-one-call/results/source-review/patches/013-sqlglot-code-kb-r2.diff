--- a/tests/dialects/test_bigquery_timestamp_bucket.py
+++ b/tests/dialects/test_bigquery_timestamp_bucket.py
@@ -0,0 +1,44 @@
+from sqlglot import exp, parse_one
+from tests.dialects.test_dialect import Validator
+
+
+class TestBigQueryTimestampBucket(Validator):
+    dialect = "bigquery"
+
+    def test_argument_order_and_origin(self):
+        for origin in (None, "bucket_origin"):
+            with self.subTest(origin=origin):
+                sql = "TIMESTAMP_BUCKET(event_time, INTERVAL '15' MINUTE"
+                sql += f", {origin})" if origin else ")"
+                expression = self.parse_one(sql)
+
+                self.assertIsInstance(expression, exp.DateBin)
+                self.assertEqual(expression.this, parse_one("INTERVAL 15 MINUTE"))
+                self.assertEqual(expression.expression, exp.column("event_time"))
+                self.assertEqual(
+                    expression.args.get("origin"), exp.column(origin) if origin else None
+                )
+
+                canonical = exp.DateBin(
+                    this=parse_one("INTERVAL 15 MINUTE"),
+                    expression=exp.column("event_time"),
+                    origin=exp.column(origin) if origin else None,
+                )
+                self.assertEqual(canonical.sql("bigquery"), sql)
+
+    def test_round_trip(self):
+        self.validate_identity(
+            "TIMESTAMP_BUCKET(event_time, INTERVAL 15 MINUTE)",
+            "TIMESTAMP_BUCKET(event_time, INTERVAL '15' MINUTE)",
+        )
+        self.validate_identity("TIMESTAMP_BUCKET(event_time, INTERVAL '15' MINUTE)")
+        self.validate_identity(
+            "TIMESTAMP_BUCKET(event_time, INTERVAL '15' MINUTE, bucket_origin)"
+        )
+        self.validate_identity(
+            "SELECT TIMESTAMP_BUCKET(TIMESTAMP('2024-01-02 12:34:56+00'), INTERVAL '2' HOUR)"
+        )
+        self.validate_identity(
+            "SELECT TIMESTAMP_BUCKET(TIMESTAMP('2024-01-02 12:34:56+00'), "
+            "INTERVAL '2' HOUR, TIMESTAMP('2024-01-01 00:00:00+00'))"
+        )
