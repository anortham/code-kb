diff --git a/test/query-parser-depth.js b/test/query-parser-depth.js
new file mode 100644
index 0000000..cfa4e81
--- /dev/null
+++ b/test/query-parser-depth.js
@@ -0,0 +1,26 @@
+'use strict'
+
+var assert = require('node:assert/strict')
+var express = require('../')
+var request = require('supertest')
+
+describe('query parser depth setting', function () {
+  it('applies the configured nesting limit to route query parameters', function (done) {
+    var app = express()
+    app.set('query parser', 'extended')
+    app.set('query parser depth', 1)
+    app.get('/', function (req, res) { res.json(req.query) })
+
+    request(app)
+      .get('/?account[profile][name]=Ada')
+      .expect(200, { account: { profile: { '[name]': 'Ada' } } }, done)
+  })
+
+  it('rejects a negative or non-integer depth without changing the setting', function () {
+    var app = express()
+
+    assert.throws(function () { app.set('query parser depth', -1) }, /non-negative integer/)
+    assert.throws(function () { app.set('query parser depth', 1.5) }, /non-negative integer/)
+    assert.strictEqual(app.get('query parser depth'), 5)
+  })
+})
