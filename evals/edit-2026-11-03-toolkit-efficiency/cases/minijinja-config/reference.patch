diff --git a/minijinja-cli/tests/edit_eval_fuel_public.rs b/minijinja-cli/tests/edit_eval_fuel_public.rs
new file mode 100644
--- /dev/null
+++ b/minijinja-cli/tests/edit_eval_fuel_public.rs
@@ -0,0 +1,54 @@
+use std::process::Command;
+
+use insta_cmd::get_cargo_bin;
+
+fn render_with_fuel(fuel: &str) -> std::process::Output {
+    Command::new(get_cargo_bin("minijinja-cli"))
+        .env("MINIJINJA_FUEL", "1")
+        .args([
+            "--fuel",
+            fuel,
+            "--no-newline",
+            "-t",
+            r#"{% for i in range(10) %}{{ i }}{% endfor %}"#,
+            "",
+        ])
+        .output()
+        .unwrap()
+}
+
+fn assert_rendered_with_fuel(fuel: &str) {
+    let output = render_with_fuel(fuel);
+    assert!(
+        output.status.success(),
+        "CLI fuel {fuel} should override MINIJINJA_FUEL=1; stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(output.stdout, b"0123456789");
+}
+
+#[test]
+fn explicit_zero_overrides_environment() {
+    assert_rendered_with_fuel("0");
+}
+
+#[test]
+fn positive_fuel_overrides_environment() {
+    assert_rendered_with_fuel("100");
+}
+
+#[test]
+fn fuel_help_documents_zero_override() {
+    let output = Command::new(get_cargo_bin("minijinja-cli"))
+        .arg("--long-help")
+        .output()
+        .unwrap();
+
+    assert!(output.status.success());
+    let help = String::from_utf8(output.stdout).unwrap();
+    let help = help.split_whitespace().collect::<Vec<_>>().join(" ");
+    assert!(
+        help.contains("An explicit --fuel value overrides MINIJINJA_FUEL; pass --fuel 0 to disable an inherited limit."),
+        "long help omitted explicit fuel precedence: {help}"
+    );
+}
