+// as found in the LICENSE.txt file.
+
+using System;
+using NodaTime;
+using NUnit.Framework;
+
+namespace NodaTime.Test;
+
+[TestFixture]
+public sealed class TryDateTimeOffsetTest
+{
+    [Test]
+    public void InstantConvertsInRangeAndTruncatesNanos()
+    {
+        var instant = Instant.FromUtc(2024, 7, 1, 12, 0).PlusNanoseconds(NodaConstants.NanosecondsPerSecond - 1);
+
+        Assert.That(instant.TryToDateTimeOffset(out var result), Is.True);
+        Assert.That(result, Is.EqualTo(new DateTimeOffset(2024, 7, 1, 12, 0, 0, TimeSpan.Zero).AddTicks(NodaConstants.TicksPerSecond - 1)));
+    }
+
+    [Test]
+    public void InstantReturnsFalseOutsideBclRange()
+    {
+        var instant = Instant.FromUtc(1, 1, 1, 0, 0).PlusNanoseconds(-1);
+
+        Assert.That(instant.TryToDateTimeOffset(out var result), Is.False);
+        Assert.That(result, Is.EqualTo(default(DateTimeOffset)));
+    }
+
+    [Test]
+    public void InstantConvertsAtUpperBclBoundary()
+    {
+        Assert.That(Instant.MaxValue.TryToDateTimeOffset(out var result), Is.True);
+        Assert.That(result, Is.EqualTo(new DateTimeOffset(DateTime.MaxValue.Ticks, TimeSpan.Zero)));
+    }
+
+    [Test]
+    public void OffsetDateTimeConvertsInRange()
+    {
+        var value = new LocalDateTime(2024, 7, 1, 12, 0).WithOffset(Offset.FromHours(5));
+
+        Assert.That(value.TryToDateTimeOffset(out var result), Is.True);
+        Assert.That(result, Is.EqualTo(new DateTimeOffset(2024, 7, 1, 12, 0, 0, TimeSpan.FromHours(5))));
+    }
+
+    [Test]
+    public void OffsetDateTimeReturnsFalseForLocalDatesOutsideBclRange()
+    {
+        var value = new LocalDate(1, 1, 1).PlusDays(-1).AtMidnight().WithOffset(Offset.FromHours(1));
+
+        Assert.That(value.TryToDateTimeOffset(out var result), Is.False);
+        Assert.That(result, Is.EqualTo(default(DateTimeOffset)));
+    }
+
+    [Test]
+    public void OffsetDateTimePreservesNonGregorianCalendarConversion()
+    {
+        var local = new LocalDateTime(2012, 6, 19, 1, 2, 3, CalendarSystem.Julian).PlusNanoseconds(123456789);
+        var value = local.WithOffset(Offset.FromHours(5));
+
+        Assert.That(value.TryToDateTimeOffset(out var result), Is.True);
+        Assert.That(result, Is.EqualTo(value.ToDateTimeOffset()));
+    }
+
+    [Test]
+    public void OffsetDateTimeReturnsFalseForUnsupportedOffsets()
+    {
+        var value = new LocalDateTime(2024, 7, 1, 12, 0).WithOffset(Offset.FromHours(15));
+
+        Assert.That(value.TryToDateTimeOffset(out var result), Is.False);
+        Assert.That(result, Is.EqualTo(default(DateTimeOffset)));
+    }
+}
