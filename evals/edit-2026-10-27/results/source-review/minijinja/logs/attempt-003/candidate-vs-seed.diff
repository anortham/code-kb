--- seed/minijinja-cli/tests/test_autoescape.rs
+++ grade-public/minijinja-cli/tests/test_autoescape.rs
@@ -0,0 +1,84 @@
+use std::fs;
+use std::process::Command;
+
+use insta_cmd::get_cargo_bin;
+
+const TEMPLATE: &str = "{{ '<tag>&' }}";
+const HTML: &str = "&lt;tag&gt;&amp;";
+const JSON: &str = "\"<tag>&\"";
+const RAW: &str = "<tag>&";
+
+fn assert_rendered(filename: &str, mode: Option<&str>, expected: &str) {
+    let dir = tempfile::tempdir().unwrap();
+    let template = dir.path().join(filename);
+    fs::write(&template, TEMPLATE).unwrap();
+
+    let mut command = Command::new(get_cargo_bin("minijinja-cli"));
+    command
+        .env_clear()
+        .current_dir(dir.path())
+        .arg("--no-newline");
+    if let Some(mode) = mode {
+        command.arg("--autoescape").arg(mode);
+    }
+    let output = command.arg(template).output().unwrap();
+    assert!(
+        output.status.success(),
+        "{filename} ({mode:?}): {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(
+        String::from_utf8(output.stdout).unwrap(),
+        expected,
+        "{filename} ({mode:?})"
+    );
+}
+
+#[test]
+fn autoescape_matches_output_suffix_with_or_without_one_wrapper() {
+    for (suffix, expected) in [
+        ("htm", HTML),
+        ("html", HTML),
+        ("xml", HTML),
+        ("xhtml", HTML),
+        ("json", JSON),
+        ("json5", JSON),
+        ("yaml", JSON),
+        ("yml", JSON),
+    ] {
+        for wrapper in ["", ".j2", ".jinja", ".jinja2"] {
+            let filename = format!("report.{suffix}{wrapper}");
+            assert_rendered(&filename, Some("auto"), expected);
+            assert_rendered(&filename.to_ascii_uppercase(), Some("auto"), expected);
+        }
+    }
+    assert_rendered("report.HtMl.JiNjA2", None, HTML);
+    assert_rendered("report.JsOn.jInJa", None, JSON);
+}
+
+#[test]
+fn autoescape_ignores_only_one_final_wrapper() {
+    for filename in [
+        "report",
+        "report.txt",
+        "report.txt.jinja2",
+        "report.jinja2",
+        "report.HTML.JINJA.J2",
+        "report.JSON.J2.JINJA2",
+        "report.html.jinja3",
+        "report.html.j2.txt",
+        "report.html.",
+        "report.ｈｔｍｌ.JINJA2",
+    ] {
+        assert_rendered(filename, Some("auto"), RAW);
+    }
+}
+
+#[test]
+fn explicit_autoescape_modes_override_filename_detection() {
+    for filename in ["report.HTML.JINJA2", "report.JSON.JINJA", "report.txt"] {
+        for (mode, expected) in [("html", HTML), ("json", JSON), ("none", RAW)] {
+            assert_rendered(filename, Some(mode), expected);
+        }
+    }
+}

