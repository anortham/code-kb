+use std::process::Command;
+
+fn render(filename: &str, mode: Option<&str>) -> String {
+    let dir = tempfile::tempdir().unwrap();
+    let template = dir.path().join(filename);
+    std::fs::write(&template, "{{ value }}").unwrap();
+
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_minijinja-cli"));
+    cmd.args(["--no-newline", "-D", "value=\""]).arg(&template);
+    if let Some(mode) = mode {
+        cmd.args(["--autoescape", mode]);
+    }
+    let output = cmd.output().unwrap();
+    assert!(
+        output.status.success(),
+        "{filename} ({mode:?}): {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8(output.stdout).unwrap()
+}
+
+#[test]
+fn test_autoescape_output_suffixes() {
+    for (extension, expected) in [
+        ("html", "&quot;"),
+        ("htm", "&quot;"),
+        ("xml", "&quot;"),
+        ("xhtml", "&quot;"),
+        ("json", "\"\\\"\""),
+        ("json5", "\"\\\"\""),
+        ("yaml", "\"\\\"\""),
+        ("yml", "\"\\\"\""),
+    ] {
+        for extension in [extension.to_string(), extension.to_ascii_uppercase()] {
+            for wrapper in ["", ".j2", ".jinja", ".jinja2", ".J2", ".JiNjA", ".JINJA2"] {
+                let filename = format!("report.{extension}{wrapper}");
+                assert_eq!(render(&filename, None), expected, "{filename}");
+            }
+        }
+    }
+}
+
+#[test]
+fn test_autoescape_only_skips_one_template_wrapper() {
+    for filename in [
+        "report",
+        "report.j2",
+        "report.jinja",
+        "report.jinja2",
+        "report.txt.j2",
+        "report.html.j2.jinja2",
+        "report.json.jinja.j2",
+        "report.html.txt.j2",
+        "report.html.jinja2.bak",
+        "report.html.jinja3",
+        "report.html.j2x",
+        "report.html.",
+        "report.İSON.J2",
+    ] {
+        assert_eq!(render(filename, Some("auto")), "\"", "{filename}");
+    }
+}
+
+#[test]
+fn test_explicit_autoescape_modes_override_suffixes() {
+    for filename in [
+        "report.html",
+        "report.json",
+        "report.HTML.JINJA2",
+        "report.JSON.JINJA",
+        "report.txt.j2",
+    ] {
+        for (mode, expected) in [("html", "&quot;"), ("json", "\"\\\"\""), ("none", "\"")] {
+            assert_eq!(render(filename, Some(mode)), expected, "{filename}: {mode}");
+        }
+    }
+    assert_eq!(render("report.html.jinja2", Some("auto")), "&quot;");
+    assert_eq!(render("report.JSON.JINJA", Some("auto")), "\"\\\"\"");
+}
+
+#[test]
+fn test_autoescape_long_help_describes_wrapped_suffixes() {
+    let output = Command::new(env!("CARGO_BIN_EXE_minijinja-cli"))
+        .arg("--long-help")
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    let help = String::from_utf8(output.stdout).unwrap();
+    let help = help.split_whitespace().collect::<Vec<_>>().join(" ");
+    assert!(help.contains("one optional .j2, .jinja, or .jinja2 suffix"));
+    assert!(help.contains("without regard to ASCII letter case"));
+    assert!(help.contains("report.html.jinja2 uses HTML escaping"));
+    assert!(help.contains("report.JSON.JINJA uses JSON escaping"));
+    assert!(help.contains("explicit modes override filename detection"));
+}

