// minijinja-cli/tests/test_autoescape.rs:3-28 (assert_autoescape)
fn assert_autoescape(filename: &str, mode: Option<&str>, expected: &str) {
    let dir = tempfile::tempdir().unwrap();
    let template = dir.path().join(filename);
    std::fs::write(&template, "{{ value }}").unwrap();

    let mut cmd = Command::new(env!("CARGO_BIN_EXE_minijinja-cli"));
    cmd.env("MINIJINJA_CONFIG_FILE", "")
        .env_remove("MINIJINJA_AUTOESCAPE")
        .arg("--no-newline")
        .arg("-Dvalue=<tag>&")
        .arg(&template);
    if let Some(mode) = mode {
        cmd.arg("--autoescape").arg(mode);
    }
    let output = cmd.output().unwrap();
    assert!(
        output.status.success(),
        "{filename} ({mode:?}): {}",
        String::from_utf8_lossy(&output.stderr)
    );
    assert_eq!(
        String::from_utf8(output.stdout).unwrap(),
        expected,
        "{filename} ({mode:?})"
    );
}

