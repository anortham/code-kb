// minijinja-cli/tests/test_autoescape.rs:86-99 (test_autoescape_long_help)
fn test_autoescape_long_help() {
    let output = Command::new(env!("CARGO_BIN_EXE_minijinja-cli"))
        .arg("--long-help")
        .output()
        .unwrap();
    assert!(output.status.success());
    let help = String::from_utf8(output.stdout).unwrap();
    let help = help.split_whitespace().collect::<Vec<_>>().join(" ");
    assert!(help.contains("A single trailing .j2, .jinja, or .jinja2 suffix is ignored"));
    assert!(help.contains("report.html.jinja2 uses HTML escaping"));
    assert!(help.contains("report.JSON.JINJA uses JSON escaping"));
    assert!(help.contains("Suffix matching ignores ASCII letter case"));
    assert!(help.contains("These explicit modes override filename detection"));
}

