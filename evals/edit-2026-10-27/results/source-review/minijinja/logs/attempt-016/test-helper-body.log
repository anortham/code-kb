// minijinja-cli/tests/test_autoescape.rs:10-32 (assert_render)
fn assert_render(filename: &str, mode: Option<&str>, expected: &str) {
    let dir = tempfile::tempdir().unwrap();
    let template = dir.path().join(filename);
    fs::write(&template, "{{ '<&' }}").unwrap();
    let mut cmd = Command::new(get_cargo_bin("minijinja-cli"));
    cmd.env_remove("MINIJINJA_AUTOESCAPE")
        .env_remove("MINIJINJA_NEWLINE")
        .env("MINIJINJA_CONFIG_FILE", dir.path().join("missing.toml"));
    if let Some(mode) = mode {
        cmd.arg("--autoescape").arg(mode);
    }
    let output = cmd.arg(template).output().unwrap();
    assert!(
        output.status.success(),
        "{filename} ({mode:?}): {}",
        String::from_utf8_lossy(&output.stderr)
    );
    assert_eq!(
        String::from_utf8(output.stdout).unwrap(),
        expected,
        "{filename} ({mode:?})"
    );
}

