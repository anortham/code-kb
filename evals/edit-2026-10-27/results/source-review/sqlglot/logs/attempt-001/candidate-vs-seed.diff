--- seed/tests/dialects/test_bigquery_timestamp_bucket.py
+++ grade-public/tests/dialects/test_bigquery_timestamp_bucket.py
@@ -0,0 +1,44 @@
+from sqlglot import exp, parse_one
+from tests.dialects.test_dialect import Validator
+
+
+class TestBigQueryTimestampBucket(Validator):
+    dialect = "bigquery"
+
+    def test_parse_argument_order(self):
+        for origin in (None, "bucket_origin"):
+            with self.subTest(origin=origin):
+                args = "ts, INTERVAL '15' MINUTE"
+                if origin:
+                    args += f", {origin}"
+                expression = self.parse_one(f"TIMESTAMP_BUCKET({args})")
+
+                self.assertIsInstance(expression, exp.DateBin)
+                self.assertEqual(expression.this, parse_one("INTERVAL '15' MINUTE"))
+                self.assertEqual(expression.expression, exp.column("ts"))
+                self.assertEqual(
+                    expression.args.get("origin"), exp.column(origin) if origin else None
+                )
+
+    def test_generate_argument_order(self):
+        for origin in (None, exp.column("bucket_origin")):
+            with self.subTest(origin=origin):
+                expression = exp.DateBin(
+                    this=parse_one("INTERVAL '15' MINUTE"),
+                    expression=exp.column("ts"),
+                    origin=origin,
+                )
+                args = "ts, INTERVAL '15' MINUTE"
+                if origin is not None:
+                    args += ", bucket_origin"
+                self.assertEqual(expression.sql("bigquery"), f"TIMESTAMP_BUCKET({args})")
+
+    def test_round_trip(self):
+        for sql in (
+            "SELECT TIMESTAMP_BUCKET(ts, INTERVAL '15' MINUTE)",
+            "SELECT TIMESTAMP_BUCKET(ts, INTERVAL '15' MINUTE, bucket_origin)",
+            "SELECT TIMESTAMP_BUCKET(ts, INTERVAL '15' MINUTE, NULL)",
+        ):
+            with self.subTest(sql=sql):
+                expression = self.validate_identity(sql)
+                self.assertEqual(self.parse_one(expression.sql("bigquery")), expression)

