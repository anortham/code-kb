{
  "name": "code-kb",
  "version": "1.2.0",
  "description": "Fast, token-dense code-intelligence engine and MCP server for AI coding agents. Requires Node.js on PATH (the plugin launcher is a Node script).",
  "author": {
    "name": "Alan Northam"
  },
  "homepage": "https://github.com/anortham/code-kb",
  "repository": "https://github.com/anortham/code-kb",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "code-intelligence",
    "ast",
    "mcp",
    "symbols",
    "progressive-disclosure"
  ],
  "hooks": "./hooks/claude-codex-hooks.json",
  "mcpServers": {
    "code-kb": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/code-kb-launcher.cjs",
        "serve"
      ]
    }
  }
}
